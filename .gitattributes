# ==============================================================================
# .gitattributes — enforce line endings independently of anyone's git config
#
# This project is edited on Windows and executed on Linux. A shell script that
# reaches the EC2 instance with CRLF endings fails at the shebang with
#   /usr/bin/env: 'bash\r': No such file or directory
# which is an unusually confusing error for an invisible character.
#
# Relying on each machine's core.autocrlf makes correctness a property of the
# developer's config rather than the repository. These rules make it a property
# of the repository.
# ==============================================================================

# Default: normalise text to LF in the repository, let git decide on checkout.
* text=auto

# Anything Linux executes must be LF in the working tree too, on every platform.
*.sh            text eol=lf
Dockerfile      text eol=lf
*.service       text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# Terraform is read by a cross-platform binary, but keep it consistent.
*.tf            text eol=lf
*.tfvars        text eol=lf
*.hcl           text eol=lf

# Never touch binaries.
*.png           binary
*.jpg           binary
*.pdf           binary
